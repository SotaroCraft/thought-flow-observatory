# Thought Flow Observatory — environment variable names only.
# Copy to `.env` locally. Never commit real values.
# Secrets and tenant-specific identifiers must stay out of the repository.

# Local data root (git-ignored). Absolute path or path relative to repo root.
THOUGHT_FLOW_DATA_ROOT=

# Optional: override public samples directory (defaults to data/samples).
THOUGHT_FLOW_SAMPLES_DIR=

# External integrations are disabled by default for local-core runs.
# Do not put credentials here in committed files. Values belong only in local `.env`
# or service-side secret stores (configured in later milestones).
THOUGHT_FLOW_ENABLE_SHAREPOINT=false
THOUGHT_FLOW_ENABLE_BIGQUERY=false
THOUGHT_FLOW_ENABLE_AZURE=false

# Placeholders for later milestones — names only; leave empty until Human configures them.
# THOUGHT_FLOW_GRAPH_TENANT_ID=
# THOUGHT_FLOW_GRAPH_CLIENT_ID=
# THOUGHT_FLOW_GRAPH_CLIENT_CREDENTIAL=
# THOUGHT_FLOW_GCP_PROJECT_ID=
# THOUGHT_FLOW_AZURE_STORAGE_CONNECTION_STRING=
