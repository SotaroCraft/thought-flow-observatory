# Thought Flow Observatory — environment variable names only.
# Copy to `.env` locally. Never commit real values.
# Secrets and tenant-specific identifiers must stay out of the repository.
# Assignments in this file must remain empty; safe defaults live in code.

# Local data root (git-ignored). Absolute path or path relative to repo root.
THOUGHT_FLOW_DATA_ROOT=

# Optional: override public samples directory (defaults to data/samples).
THOUGHT_FLOW_SAMPLES_DIR=

# External integration flags (empty here; loader defaults to disabled).
THOUGHT_FLOW_ENABLE_SHAREPOINT=
THOUGHT_FLOW_ENABLE_BIGQUERY=
THOUGHT_FLOW_ENABLE_AZURE=

# M4 Graph / SPO smoke (delegated public client; leave empty in Git).
# Values stay in local `.env` only. Do not commit real IDs or paths.
THOUGHT_FLOW_GRAPH_CLIENT_ID=
THOUGHT_FLOW_GRAPH_TENANT_ID=
THOUGHT_FLOW_SPO_HOSTNAME=
THOUGHT_FLOW_SPO_SITE_PATH=

# Placeholders for later milestones — names only; leave empty until Human configures them.
# THOUGHT_FLOW_OPENALEX_API_KEY=
# Optional path to Human-held Trends alpha invitation credential material (never commit).
# Presence alone does not authorize inventing an API client from public docs.
# THOUGHT_FLOW_TRENDS_ALPHA_CREDENTIAL_PATH=
# THOUGHT_FLOW_GCP_PROJECT_ID=
# THOUGHT_FLOW_AZURE_STORAGE_CONNECTION_STRING=
